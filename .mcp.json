{
  "mcpServers": {
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "vgpu": {
      "command": "npx",
      "args": [
        "-y",
        "vgpu@latest",
        "mcp"
      ]
    }
  }
}
